---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You | Line International Project L.L.C." page="thank-you">
    <div>
        <section class="flex-row">
			<img src="/icons/submitted.svg" alt="Succesfull Submission Icon" width="100" height="100">
            <h2>Thank You</h2>
			<p>Your form has been submitted successfully. <br>One of our representatives will review your request and contact you as soon as possible.</p>
            <a href="/">Go back to Home</a>
        </section>
    </div>
</Layout>

<style>
    div {
        padding-inline: 2rem;
    }

    section {
        max-width: var(--max-width);
        border-inline: var(--border-dark);
        margin: 0 auto;
        width: 100%;
        text-align: center;
        flex-direction: column;
        justify-content: center;
        height: 100%;

		padding: 2rem 2rem 4rem;
    }

	img {
		margin-bottom: 1rem;
	}

    h2 {
        color: var(--primary-200);
    }

	p {
		color: var(--black-10);
		font-size: 0.9rem
	}

    a {
        display: inline-block;
        background-color: var(--primary-400);
        color: var(--white-95);
        padding: 1rem 2.25rem;
        padding: clamp(0.75rem, 1vw, 1rem) clamp(1.5rem, 2vw, 2.25rem);
        font-size: 1.5rem;
        font-size: var(--font-24);
        border-radius: 0.75rem;
        transform-origin: center;
        font-weight: 500;
        text-align: center;
		margin-top: 1.5rem;
    }

    a:hover {
        text-decoration: none;
    }
</style>