---
import PageHeader from "../components/PageHeader.astro";
import PageFooter from "../components/PageFooter.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{Astro.props.title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:ital,opsz@0,14..32;1,14..32&display=swap" rel="stylesheet">
		
	</head>
	<body>
		<PageHeader page={Astro.props.page}/>
		<slot />
		<PageFooter page={Astro.props.page}/>

		<style is:global>
						:root {
				--primary-900: #ECFBFE;
				--primary-400: #15616D;
				--primary-300: #0C3940;
				--primary-200: #143642;
				--primary-100: #041315;

				--white-90: hsl(0 0 90%);
				--white-95: hsl(0 0 95%);
				--black-10: hsl(0 0 10%);
				
				

				--max-width: 90rem;

				--dm-serif: "DM Serif Display", serif;
				--inter: "Inter", sans-serif;
				
				--border-width: 0.125rem;

				--border-dark: var(--border-width) solid var(--primary-200);
				--border-light: var(--border-width) solid var(--white-95);
			}	

			* {
				padding: 0;
				margin: 0;
				box-sizing: border-box;
				font-family: var(--inter);
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				background-color: var(--white-95);
			}

			.flex-row {
				display: flex;
				flex-flow: row nowrap;
				align-items: center;
			}

			.flex-start {
				align-items: flex-start;
			}

			h1, h2, h3 {
				font-family: var(--dm-serif)
			}

			a {
				color: inherit;
				text-decoration: none;
				transition: all 0.25s;
			}

			a:hover {
				opacity: 0.5;
				text-decoration: underline;
			}

			a:active {
				opacity: 0.2;
				text-decoration: none;
			}

			html {
				background-color: var(--primary-100);
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}
		</style>
	</body>
</html>

