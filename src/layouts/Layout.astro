---
import PageHeader from "../components/PageHeader.astro";
import PageFooter from "../components/PageFooter.astro";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{Astro.props.title}</title>

		 <Font cssVariable="--font-dm-serif" preload />
		 <Font cssVariable="--font-inter"/>
		 <Font cssVariable="--font-azeret-mono"/>
		
	</head>
	<body>
		<PageHeader page={Astro.props.page}/>
		<slot />
		<PageFooter page={Astro.props.page}/>

		<style is:global>
						:root {
				--primary-900: #ECFBFE;
				--primary-400: #15616D;
				--primary-300: #0C3940;
				--primary-200: #143642;
				--primary-100: #041315;
				

				--black-10: hsl(0 0 10%);
				--gray: hsl(0 0 50%);
				--white-85: hsl(0 0 85%);
				--white-90: hsl(0 0 90%);
				--white-95: hsl(0 0 95%);
				--white-100: #fff;

				--red-40: hsl(0, 100%, 40%);

				
				

				--max-width: 90rem;

				--dm-serif: var(--font-dm-serif), serif;
				--inter: var(--font-inter), sans-serif;
				--azeret: var(--font-azeret-mono), monospace;
				
				--border-width: 0.125rem;

				--border-dark: var(--border-width) solid var(--primary-200);
				--border-light: var(--border-width) solid var(--white-95);
			}	

			* {
				padding: 0;
				margin: 0;
				box-sizing: border-box;
				font-family: var(--inter);
			}

			html {
				scroll-behavior: smooth;
				scrollbar-gutter: stable;
			}

			body {
				background-color: var(--white-95);

				min-block-size: 100svh;
				display: grid;
				grid-template-rows: auto 1fr auto;
				
			}

			.flex-row {
				display: flex;
				flex-flow: row nowrap;
				align-items: center;
			}

			.flex-start {
				align-items: flex-start;
			}

			h1, h2, h3 {
				font-family: var(--dm-serif);
			}

			h1, h2, h3, h4 {
				font-weight: 400;
			}

			h2 {
				font-size: 3rem;
			}

			a {
				color: inherit;
				text-decoration: none;
				transition: all 0.25s;
			}

			a:hover {
				opacity: 0.5;
				text-decoration: underline;
			}

			a:active {
				opacity: 0.2;
				text-decoration: none;
			}

			html {
				background-color: var(--primary-100);
			}

			.hidden {
				display: none;
			}

			.stack {
				display: grid;
			}

			.stacked-item {
				grid-area: 1 / 1;
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}
		</style>
	</body>
</html>

