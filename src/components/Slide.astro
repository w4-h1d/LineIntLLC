---
const {client, location, start, end, img, project } = Astro.props;

import { Image } from 'astro:assets';

import PersonLogo from '../assets/icons/person-slide-icon.svg';
import LocationLogo from '../assets/icons/location-slide-icon.svg';
import DurationLogo from '../assets/icons/duration-slide-icon.svg';


---


<div class="container swiper-slide">
    <div class="bg-cont">
        <Image src={ img } alt={ "Image of " + project } width={ img.width } height={ img.height } />
    </div>    
    <article class="stacked-item" data-swiper-parallax="-400" data-swiper-parallax-scale="0.5" data-swiper-parallax-duration="500">
        <div data-swiper-parallax="-400">
            <PersonLogo width={24} height={24} fill="currentColor" class="icon" />
            <p>{ client }</p>
        </div>
        <div data-swiper-parallax="-500">
            <LocationLogo width={24} height={24} fill="currentColor" class="icon" />
            <p>{ location }</p>
        </div>
        <div data-swiper-parallax="-600">
            <DurationLogo width={24} height={24} fill="currentColor" class="icon" />
            <p>{ start } to { end }</p>
        </div>
    </article>

</div>


<style>
    .icon {
        color: var(--primary-200);
        flex-grow: 0;
        flex-shink: 0;
    }

    p {
        color: var(--primary-200);
        font-weight: 600;
        font-size: var(--font-16);
    }

    .container {
        position: relative;
        width: 100%;
        background-color: var(--primary-200);
        /* box-shadow: var(--box-shadow); */
        border-radius: var(--border-radius);
    }

    article {
        background-color: var(--primary-900);
        padding: 1rem;
        border-radius: calc(var(--border-radius) - 0.25rem);

        display: flex;
        flex-flow: column nowrap;
        gap: clamp(0.75rem, 4vw, 1rem);
        justify-content: flex-start;

        position: absolute;
        bottom: clamp(1.5rem, 2.5vw, 2.5rem);
        left: clamp(1rem, 2vw, 2rem);
    }

    article > div {
        display: flex;
        flex-flow: row nowrap;
        gap: 0.5rem;
        align-items: center;
        justify-content: flex-start;
    }

    .bg-cont {
        height: 100%;
    }

    .bg-cont img {
        width: 100%;
        height: 100cqh;
        object-fit: cover;
        border-radius: var(--border-radius);
    }

    a:hover {
        opacity: 1;
    }

    @media all and (max-width: 36rem) {
        .container {
            border: 1px solid var(--gray);
            position: static;
            display: flex;
            flex-flow: column nowrap;
        }

        p {
            font-size: var(--font-16);
            color: var(--white-95);
        }

        .icon {
            color: var(--white-95);
        }

        article {
            position: static;
            background-color: transparent;
            padding-bottom: 1.5rem;
            flex-grow: 1;
            flex-basis: 10rem;
        }

        .bg-cont  img {
            /* box-shadow: var(--box-shadow); */
            height: auto;
            aspect-ratio: 4 / 3;
        }
    }
</style>