---
const {service, description, img, alt, id} = Astro.props;

const message = "Hello, I would like to enquire about " + service;

const enquiryLink = encodeURI(`https://api.whatsapp.com/send?phone=96896127475&text=${message}.`);
---

<div id={ id }>
    <img src={img} alt={alt} width="400" height="267" loading="lazy">

    <article>
        <h3>{service}</h3>
        <p>{description}</p>
        <a href={ enquiryLink } target="_blank">Get a quote <span></span></a>
    </article>
</div>

<style>
    div {
        width: 25rem;
        max-width: 100%;
        border-radius: var(--border-radius);
        background-color: var(--primary-900);
        box-shadow: var(--box-shadow);
        overflow: hidden;
        transition: all ease-in-out 0.35s;
    }

    article {
        padding: 1rem;
    }

    h3 {
        font-size: var(--font-24);
        color: var(--primary-200);
    }

    p {
        font-size: var(--font-16);
        color: var(--black-10);
        margin-top: 1rem;
        margin-bottom: 1rem;
        line-height: 1.75;
    }

    img {
        width: 25rem;
        height: auto;
        max-width: 100%;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        transition: all ease-in-out 0.3s;
    }

    a {
        border: 1px solid var(--primary-200);
        padding: clamp(0.25rem, 1vw, 0.5rem) clamp(0.75rem, 2vw, 1rem);
        border-radius: 0.5rem;
        display: inline-block;
        margin: 0.25rem 0 clamp(0.15rem, 0.5vw, 0.5rem);
        color: var(--black-10);
        font-size: var(--font-14);
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    span {
        display: block;
        position: absolute;
        bottom: 0;
        left: 50%;
        background-color: var(--primary-200);
        width: 10%;
        height: 100%;
        border-radius: 2rem;
        z-index: -1;
        transform: translateX(-50%) translateY(100%);
        transition: all 0.35s;
    }

    a:hover > span {
        left: 0;
        transform: translateX(0) translateY(0);
        border-radius: 0.425rem;
        width: 100%;
    }

    a:after {
        content: "→";
        margin-left: 1ch;
        display: inline-block;
        transition: transform 0.35s;
    }

    a:hover:after {
        transform: translateX(0.5ch);
    }

    a:hover {
        border-color: transparent;
        text-decoration: none;
        opacity: 1;
        color: var(--white-95);
    }

    a:active {
        opacity: 0.8;
        transform: scale(0.95);
    }

    div:hover {
        background-color: var(--accent-900);

        img {
            transform: scale(1.05);
        }
    }

    @media all and (max-width: 64.25rem) {
        div {
            width: 100%;
            display: flex;
        }

        img {
            width: 100%;
            max-width: 12.5rem;
            object-fit: cover;
        }
    }

    @media all and (max-width: 33rem) {
        div {
            display: block;
        }

        img {
            max-width: 100%;

        }
    }
</style>