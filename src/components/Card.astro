---
const {service, description, img, alt, id} = Astro.props;
---

<div id={ id }>
    <img src={img} alt={alt} width="400" height="267" loading="lazy">
    <article>
        <h3>{service}</h3>
        <p>{description}</p>
    </article>
</div>

<style>
    div {
        width: 25rem;
        max-width: 100%;
        border-radius: var(--border-radius);
        background-color: var(--primary-900);
        box-shadow: var(--box-shadow);
        overflow: hidden;
        transition: all ease-in-out 0.35s;
    }

    article {
        padding: 1rem;
    }

    h3 {
        font-size: var(--font-24);
        color: var(--primary-200);
    }

    p {
        font-size: var(--font-16);
        color: var(--black-10);
        margin-top: 1rem;
        margin-bottom: 1rem;
        line-height: 1.75;
    }

    img {
        width: 25rem;
        height: auto;
        max-width: 100%;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        transition: all ease-in-out 0.3s;
    }

    div:hover {
        background-color: var(--accent-900);

        img {
            transform: scale(1.05);
        }
    }

    @media all and (max-width: 64.25rem) {
        div {
            width: 100%;
            display: flex;
        }

        img {
            width: 100%;
            max-width: 12.5rem;
            object-fit: cover;
        }
    }

    @media all and (max-width: 33rem) {
        div {
            display: block;
        }

        img {
            max-width: 100%;

        }
    }
</style>