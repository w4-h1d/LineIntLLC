---
const {service, description, img, id} = Astro.props;

const message = "Hello, I would like to enquire about " + service;

const enquiryLink = encodeURI(`https://api.whatsapp.com/send?phone=96896127475&text=${message}.`);
---

<div id={ id } class="container">
    <div class="image-cont">
        <img src={ img } alt={ service } width="400" height="267" loading="lazy">
    </div>

    <article>
        <h3>{ service }</h3>
        <p>{ description }</p>
        <a href={ enquiryLink } target="_blank">Get a quote <span></span></a>
    </article>
</div>

<style>
    .container {
        width: 25rem;
        max-width: 100%;
        border-radius: var(--border-radius);
        background-color: var(--primary-900);
        box-shadow: var(--box-shadow);
        overflow: hidden;
        transition: all ease-in-out 0.35s;
        transition-delay: 0.25s;
    }

    .container:hover {
        background-color: oklch(from var(--accent-900) l calc(c - 0.015) h);
        transition-delay: 0s;

        img {
            transform: scale(1.025);
        }
    }

    article {
        padding: 1rem;
    }

    h3 {
        font-size: var(--font-24);
        color: var(--primary-200);
    }

    p {
        font-size: var(--font-16);
        color: var(--black-10);
        margin-top: 1rem;
        margin-bottom: 1rem;
        line-height: 1.75;
    }

    .image-cont {
        width: 100%;
        height: 16.6875rem;
        height: auto;
        max-height: 100%;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        transition: all ease-in-out 0.3s;
        overflow: hidden;
    }

    a {
        border: 1px solid var(--primary-200);
        padding: clamp(0.25rem, 1vw, 0.5rem) clamp(0.75rem, 2vw, 1rem);
        border-radius: 0.5rem;
        display: inline-block;
        margin: 0.25rem 0 clamp(0.15rem, 0.5vw, 0.5rem);
        color: var(--black-10);
        font-size: var(--font-14);
        position: relative;
        overflow: hidden;
        z-index: 1;
        transition-delay: 0.05s;
    }

    span {
        display: block;
        position: absolute;
        bottom: 0;
        left: 50%;
        background-color: var(--primary-200);
        width: 10%;
        height: 100%;
        border-radius: 2rem;
        z-index: -1;
        transform: translateX(-50%) translateY(100%);
        transition: all 0.35s;
        transition-delay: 0.05s;
    }

    a:hover > span {
        left: 0;
        transform: translateX(0) translateY(0);
        border-radius: 0.425rem;
        width: 100%;
        transition-delay: 0s;
    }

    a:after {
        content: "→";
        margin-left: 1ch;
        display: inline-block;
        transition: transform 0.35s;
    }

    a:hover:after {
        transform: translateX(0.5ch);
        transition-delay: 0s;
    }

    a:hover {
        border-color: transparent;
        text-decoration: none;
        opacity: 1;
        color: var(--white-95);
        transition-delay: 0s;
    }

    a:active {
        opacity: 0.8;
        transform: scale(0.95);
    }

    img {
        width: 100%;
        height: 100%;
        transition: all 0.25s;
        object-fit: cover;
        object-position: center;
    }

    @media all and (max-width: 64.25rem) {
        .container {
            width: 100%;
            display: flex;
        }

        .image-cont {
            /* min-width: 12.5rem; */
            flex: 0 1 18rem;
        }

        article {
            flex: 1 1.15 30rem;
        }
    }

    @media all and (max-width: 33rem) {
        .container {
            display: block;
        }

    }
</style>