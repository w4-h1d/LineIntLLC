---
import CountryCode from '../components/CountryCode.astro';
const { heading } = Astro.props;
---

<section>
    <h2>{ heading }</h2>
    <form action="" id="contact-form">
        <div>
            <label for="full_name">Name</label>
            <input type="text" name="full_name" id="full_name" placeholder="Full Name">
        </div>

        <div>
            <label for="phone">Phone</label>
            <div class="flex-row">
                <CountryCode />
                <input type="tel" name="phone_number" id="phone_number" placeholder="9000 1000">
            </div>
            <input type="hidden" name="phone" id="phone" >
        </div>

        <div>
            <label for="email">Email</label>
            <input type="email" name="email" id="email" placeholder="johndoe@customer.com">
        </div>

        <div>
            <label for="location">Location</label>
            <input type="text" name="location" id="location" placeholder="Project Address">
        </div>

        <div>
            <label for="description">Description</label>
            <textarea name="description" id="description" placeholder="Your dream project"></textarea>
        </div>

        <div class="flex-row">
            <button type="submit" id="submit-btn">Send Message</button>
            <button type="reset">Clear</button>
        </div>

    </form>
</section>

<script>
