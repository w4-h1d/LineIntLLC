---
import CountryCode from '../components/CountryCode.astro';
const { heading } = Astro.props;
---

<section class="container" id="contact-form">
    <section>
        <h2>{ heading }</h2>
        <div class="form-cont">
            <form action="https://api.staticforms.dev/submit" method="POST" id="contact-form">
                <input type="hidden" name="apiKey" value="sf_9b49816fa0c31f2d394ed0c5">
                <div>
                    <label for="full_name">Name <span class="required">*</span></label>
                    <input type="text" name="Full Name" id="full-name" placeholder="Full Name" required>
                </div>

                <div>
                    <label for="phone">Phone <span class="required">*</span></label>
                    <div class="flex-row">
                        <CountryCode />
                        <input type="tel" id="phone-number" placeholder="9000 1000" required>
                    </div>
                    <input type="hidden" name="Phone" id="phone" >
                </div>

                <div>
                    <label for="email">Email <span class="required">*</span></label>
                    <input type="email" name="Email" id="email" placeholder="johndoe@customer.com" required>
                </div>

                <div>
                    <label for="location">Location</label>
                    <input type="text" name="Location" id="location" placeholder="Project Address">
                </div>

                <div>
                    <label for="description">Description <span class="required">*</span></label>
                    <textarea name="Description" id="description" placeholder="Your dream project" required></textarea>
                </div>

                <input type="hidden" name="redirectTo" value="https://najmul.one/thank-you">

                <div class="flex-row">
                    <button type="submit" id="submit-btn">Send Message</button>
                    <button type="reset">Clear</button>
                </div>
            </form>

            <div class="stack">
                <img src="/images/building-form-section.webp" alt="" class="form-img stacked-item" width="425" height="636" loading="lazy">
                <img src="/images/form-bg.svg" alt="" class="bg-shape stacked-item" loading="lazy">
            </div>
        </div>
    </section>
</section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const countryCode = document.getElementById("country-code") as HTMLInputElement | null;
    const phoneNumber = document.getElementById("phone-number") as HTMLInputElement | null;
    const phone = document.getElementById("phone") as HTMLInputElement | null;

    form?.addEventListener("submit", e => {
        if (countryCode && phoneNumber && phone) {
            phone.value = countryCode.value + phoneNumber.value;
        } 
    })

</script>

<style>
    .container {
        padding-inline: 2rem;
        border-top: var(--border-dark);
    }

    .container > section {
        width: 100%;
        max-width: var(--max-width);
        padding: 2rem;
        border-inline: var(--border-dark);
        margin: 0 auto;
    }

    .form-cont {
        display: flex;
        gap: clamp(2rem, 5vw, 5.25rem);
        align-items: center;
        justify-content: center;
        margin-bottom: 5rem;
        padding-right: 1rem;
    }

    .form-img {
        border-radius: 1rem;
        border-radius: var(--border-radius);
        z-index: 1;
        box-shadow: var(--box-shadow);
        width: 100%;
        max-width: 26.5625rem;
        height: 100%;
        object-fit: cover;
    }

    .bg-shape {
        z-index: 0;
        position: absolute;
        bottom: 4rem;
        left: 2.5rem;
        width: 100%;
        height: 100%;
    }

    form {
        padding: 1.25rem;
        font-size: var(--font-16);
        background-color: var(--white-100);
        border-radius: 1rem;
        border-radius: calc(var(--border-radius) + 0.25rem);
        border: 1px solid var(--white-85);
        box-shadow: var(--box-shadow);

        width: 100%;
        flex: 0 1.75 30rem;
    }


    div:has(img) {
        position: relative;
        height: 100%;
        width: 100%;
        flex: 0 1 30rem;
    }



    h2 {
        color: var(--primary-200);
        margin: 2rem 0 6rem 0;
        margin-left: clamp(0.01rem, 1.25vw * 6, 9rem);
    }

    button, input, textarea {
        font-size: inherit;
    }

    label {
        color: var(--primary-200);
        margin: 1.25rem 0 0.75rem;
        font-weight: 500;
    }

    label, input, textarea {
        display: block;
        width: 100%;
    }

    input, textarea {
        border-radius: 0.75rem;
        border-radius: calc(var(--border-radius) - 0.25rem);
        border: 1px solid var(--white-85);
        padding: 0.5rem 1rem;
        background-color: var(--white-100);
        font-family: var(--azeret);
        font-weight: 200;
        color: var(--black-10);
    }

    textarea {
        field-sizing: content;
        min-height: 10rem; 
        min-height: 6lh; 
        height: auto;
        max-width: calc(100svw - 4rem);
    }

    input::placeholder, textarea::placeholder {
        color: var(--gray);
    }

    form > div > div {
        gap: 1rem;
    }

    div:has(button) {
        width: 100%;
        gap: 1rem;
        margin-top: 1.5rem;
        align-items: stretch;
    }

    button {
        padding: var(--font-16);
        border-radius: 0.875rem;
        border-radius: calc(var(--border-radius) - 0.25rem);
        border: 1px solid var(--white-85);
        width: 100%;
        cursor: pointer;
        transform-origin: center;
        transition: all ease-in-out 0.25s;
        display: inline-flex;
        flex-grow: 1;

        justify-content: center;
        align-items: center;
    }

    button[type="submit"] {
        background-color: var(--primary-400);
        color: var(--white-95);
    }

    button[type="reset"] {
        color: var(--primary-200);
        border-color: var(--primary-200);
        background-color: var(--white-95);
    }

    button:hover {
        background-color: var(--primary-200);
        color: var(--white-95);
    }

    button:active {
        opacity: 0.8;
        transform: scale(0.95);
    }

    .required {
        color: var(--red-40);
    }

    form > div:first-child  {
        background-color: red;
        margin: 0;
    }

    @media all and (max-width: 48rem) {
        h2 {
            margin-left: 0;
            margin-bottom: 3rem;
            text-align: center;
        }

        .form-cont {
            padding: 0;
        }

        div:has(img) {
            display: none;
        }
    }
</style>