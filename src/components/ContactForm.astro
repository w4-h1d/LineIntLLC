    submitBtn?.addEventListener("click", e => {
        e.preventDefault();
        const fullNum = country_code.value + phone_number.value;
        phone.setAttribute("value", fullNum);
        form?.submit();
    }); */
</script>

<style>
    form {
        padding: 2rem;
        font-size: 1.5rem;
        background-color: var(--white-100);
        border-radius: 1.25rem;
        border: 1px solid var(--white-85);
        box-shadow: 0 0.125rem 0.5rem 0.125rem hsla(0, 0%, 0%, 0.15);
    }

    button, input, textarea {
        font-size: inherit;
    }

    label {
        color: var(--primary-200);
        margin: 1.5rem 0 1rem;
        font-weight: 500;
    }

    label, input, textarea {
        display: block;
        width: 100%;
    }

    input, textarea {
        border-radius: 0.75rem;
        border: 1px solid var(--white-85);
        padding: 0.5rem 1rem;
        background-color: var(--white-100);
        font-family: var(--azeret);
        font-weight: 200;
        color: var(--black-10);
    }

    textarea {
        field-sizing: content;
        min-height: 10rem;
        height: auto;
        max-width: calc(100svw - 4rem);
    }

    input::placeholder, textarea::placeholder {
        color: var(--gray);
    }

    form > div > div {
        gap: 1rem;
    }

    div:has(button) {
        width: 100%;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    button {
        padding: 1rem 1.5rem;
        border-radius: 0.875rem;
        border: 1px solid var(--white-85);
        width: 100%;
        cursor: pointer;
        transform-origin: center;
        transition: all ease-in-out 0.25s;
    }

    button[type="submit"] {
        background-color: var(--primary-400);
        color: var(--white-95);
    }

    button[type="reset"] {
        color: var(--primary-200);
        border-color: var(--primary-200);
    }

    button:hover {
        background-color: var(--primary-200);
        color: var(--white-95);
    }

    button:active {
        opacity: 0.8;
        transform: scale(0.95);
    }


</style>