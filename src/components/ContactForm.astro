---
import { Image } from 'astro:assets';
import CountryCode from '../components/CountryCode.astro';
import BuildingImg from '../assets/images/building-form-section.webp';
const { heading } = Astro.props;

import WhatsAppIconSvg from '../assets/icons/whatsapp.svg';
---

<section class="container" id="contact-form">
    <section>
        <section>
            <h2>{ heading }</h2>
            <div class="form-cont">
                <form action="https://api.whatsapp.com/send" id="contact-form">
                    <div>
                        <label for="name">Name <span class="required">*</span></label>
                        <input type="text" id="name" placeholder="Full Name" required>
                    </div>

                    <div>
                        <label for="phone-number">Phone <span class="required">*</span></label>
                        <div class="flex-row">
                            <CountryCode />
                            <input type="tel" id="phone-number" placeholder="9000 1000" required>
                        </div>
                    </div>

                    <div>
                        <label for="email">Email <span class="required">*</span></label>
                        <input type="email" id="email" placeholder="johndoe@customer.com" required>
                    </div>

                    <div>
                        <label for="location">Location</label>
                        <input type="text" id="location" placeholder="Project Address">
                    </div>

                    <div>
                        <label for="description">Description <span class="required">*</span></label>
                        <textarea id="description" placeholder="Your dream project" required></textarea>
                    </div>

                    

                    <input type="hidden" name="phone" value="96896127475">
                    <input type="hidden" name="text" value="" id="text">

                    <div class="flex-row">
                        <button type="submit" id="submit-btn">Send Message</button>
                        <button type="reset">Clear</button>
                    </div>

                    <small>Your message will be sent via WhatsApp.</small>
                </form>

                <div class="">
                    
                    <img src="/images/form-bg.svg" alt="" class="bg-shape" loading="lazy">

                    <Image 
                        src={ BuildingImg } 
                        alt="Building Outline"
                        width={ BuildingImg.width }
                        height={ BuildingImg.height }
                        class="form-img"
                    />
                </div>
            </div>
        </section>
    </section>
</section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;

    const name = document.getElementById("name") as HTMLInputElement | null;

    const countryCode = document.getElementById("country-code") as HTMLInputElement | null;

    const phoneNumber = document.getElementById("phone-number") as HTMLInputElement | null;

    const email = document.getElementById("email") as HTMLInputElement | null;

    const location = document.getElementById("location") as HTMLInputElement | null;

    const description = document.getElementById("description") as HTMLInputElement | null;

    const text = document.getElementById("text") as HTMLInputElement | null;

    form?.addEventListener("submit", e => {
        if (text) {
            text.value = 
`Name: *${name?.value}*
Phone: ${countryCode?.value}${phoneNumber?.value.match(/\d+/g)?.join("")}
Email: ${email?.value}
Location: ${location?.value}

${description?.value}`;
        }
    })

</script>

<style>
    .container {
        padding-inline: var(--outer-padding-inline);
        border-top: var(--border-dark);
    }

    .container > section {
        width: 100%;
        max-width: var(--max-width);
        padding: 2rem var(--inner-padding-inline);
        padding-left: calc(1rem + var(--inner-padding-inline));
        border-inline: var(--border-dark);
        margin: 0 auto;
    }

    .container > section > section {
        width: 100%;
        max-width: 65rem;
        margin: 0 auto;
    }



    .form-cont {
        display: flex;
        gap: clamp(1rem, 3.5vw, 5.25rem);
        align-items: center;
        justify-content: space-between;
        margin-bottom: 5rem;
    }

    .form-img {
        border-radius: 1rem;
        border-radius: var(--border-radius);
        z-index: 3;
        box-shadow: var(--box-shadow);
        width: 100%;
        max-width: 26.5625rem;
        width: clamp(18.75rem, 35vw, 26.5625rem);
        height: 100%;
        object-fit: cover;
        position: relative;

    }

    .bg-shape {
        z-index: 0;
        position: absolute;
        bottom: clamp(1.5rem, 5vw, 4rem);
        left: clamp(1.5rem, 3vw, 3.5rem);
        width: 100%;
        height: 100%;

    }

    form {
        padding: 1.25rem;
        font-size: var(--font-16);
        background-color: var(--white-100);
        border-radius: 1rem;
        border-radius: calc(var(--border-radius) + 0.25rem);
        border: 1px solid var(--white-85);
        box-shadow: var(--box-shadow);

        width: 100%;
        flex: 0 1.75 30rem;
    }


    div:has(img) {
        position: relative;
        height: max-content;
        width: 100%;
        flex: 0 0.75 25rem;
    }



    h2 {
        color: var(--primary-200);
        margin: 4rem 0;
        /* margin-left: clamp(0.01rem, 1.85vw * 6, 12rem);
        /* text-align: center; */
    }

    button, input, textarea {
        font-size: inherit;
    }

    label {
        color: var(--primary-200);
        margin: 1.25rem 0 0.75rem;
        font-weight: 500;
    }

    label, input, textarea {
        display: block;
        width: 100%;
    }

    input, textarea {
        border-radius: 0.75rem;
        border-radius: calc(var(--border-radius) - 0.25rem);
        border: 1px solid var(--white-85);
        padding: 0.5rem 1rem;
        background-color: var(--white-100);
        font-family: var(--azeret);
        font-weight: 200;
        color: var(--black-10);
    }

    textarea {
        field-sizing: content;
        min-height: 10rem; 
        min-height: 6lh; 
        height: auto;
        max-width: calc(100svw - 4rem);
    }

    input::placeholder, textarea::placeholder {
        color: var(--gray);
    }

    form > div > div {
        gap: 1rem;
    }

    div:has(button) {
        width: 100%;
        gap: 1rem;
        margin-top: 1.5rem;
        align-items: stretch;
    }

    button {
        padding: var(--font-16);
        border-radius: 0.875rem;
        border-radius: calc(var(--border-radius) - 0.25rem);
        border: 1px solid var(--white-85);
        width: 100%;
        cursor: pointer;
        transform-origin: center;
        transition: all ease-in-out 0.25s;
        display: inline-flex;
        flex-grow: 1;

        justify-content: center;
        align-items: center;
    }

    button[type="submit"] {
        background-color: var(--primary-400);
        color: var(--white-95);
    }

    button[type="reset"] {
        color: var(--primary-200);
        border-color: var(--primary-200);
        background-color: var(--white-95);
    }

    button:hover {
        background-color: var(--primary-200);
        color: var(--white-95);
    }

    button:active {
        opacity: 0.8;
        transform: scale(0.95);
    }

    .required {
        color: var(--red-40);
    }

    small {
        text-align: center; 
        display: block;
        margin-top: 1rem;
        color: var(--black-10);
    }


    @media all and (max-width: 55rem) {
        h2 {
            margin-left: 0;
            margin-bottom: 3rem;
            text-align: center;
        }

        .form-cont {
            padding: 0;
            justify-content: center;
        }

        div:has(img) {
            display: none;
        }
    }
</style>