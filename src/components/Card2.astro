---
const {title, description, icon} = Astro.props;
---

<article>
    <img src={ icon} alt={"Icon for " + title } width="64" height="64">
    <h4>{ title }</h4>
    <p>{ description }</p>
</article>

<style>
    article {
        padding: 2rem;
        background-color: var(--primary-900);
        border-radius: 1rem;
    }

    h4 {
        font-size: 1.5rem;
        color: var(--primary-200);
        font-family: var(--dm-serif);
        margin-top: 2rem;
    }

    p {
        font-size: 1rem;
        color: var(--black-10);
        line-height: 1.5;
        margin-top: 1rem;
    }

    img {
        color: var(--primary-200);
        fill: var(--primary-200);
    }
    
    article:last-child {
        grid-column: 1/3;
    }
</style>