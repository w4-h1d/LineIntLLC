---

---
<footer>
    <div class="wrapper">
        <div class="flex-row flex-start">
            <div class="logo-social">
                <section class="logo">
                    <img src="/icons/line-logo-w.svg" alt="Logo of Line International Project LLC" width="100" height="100" loading="lazy">
                    <h3>Line&nbsp;International Project&nbsp;L.L.C.</h3>
                </section>

                <section class="flex-start social-cont">
                    <h3>Follow us on</h3>

                    <section class="flex-row socials">
                        <a href="https://facebook.com/najmulhudawahid" target="_blank">
                            <img src="/icons/facebook.svg" alt="Facebook Link" width="20" height="20" loading="lazy">
                        </a>
                        <a href="https://instagram.com/w4.h1d" target="_blank">
                            <img src="/icons/instagram.svg" alt="Instagram Link" width="20" height="20" loading="lazy">
                        </a>
                        <a href="http://wa.me/96896127475?text=Hello">
                            <img src="/icons/whatsapp.svg" alt="WhatsApp Link" width="20" height="20" loading="lazy">
                        </a>
                    </section>
                </section>
            </div>

            <div class="flex-row links-container">
                <section>
                    <h3>Quick Links</h3>
                    <ul>
                        { Astro.props.page !== "home" && <li><a href="/">Home</a></li>}
                        <li><a href="/#portfolio">Portfolio</a></li>
                        <li><a href="/#services">Services</a></li>
                        <li><a href="/#chairman">Chairman's Message</a></li>
                        { Astro.props.page !== "about" && <li><a href="/about">About&nbsp;Us</a></li>}
                        <li><a href="">The Golden Footprint of Trade SPC</a></li>
                        { Astro.props.page !== "locations" && <li><a href="/locations">Locations</a></li> }
                    </ul>
                </section>

                <section>
                    <h3>Our Services</h3>
                    <ul>
                        <li><a href="/#construction-services">Construction Services</a></li>
                        <li><a href="/#waterproofing-solutions">Waterproofing Solutions</a></li>
                        <li><a href="/#design-and-decoration">Design and Decoration</a></li>
                        <li><a href="/#paiting-services">Premium Painting Services</a></li>
                        <li><a href="/#pest-control">Pest Control</a></li>
                        <li><a href="/#property-maintenance">Property Maintenance</a></li>
                    </ul>
                </section>

                <section class="contact">
                    <h3>Contact Information</h3>
                    <ul>
                        <li class="flex-row">
                            <img src="/icons//call.svg" alt="Phone Icon" width="16" height="16" loading="lazy">
                            <a href="tel:+96896127473">+968 9612 7473</a>
                        </li>
                        <li class="flex-row">
                            <img src="/icons//message.svg" alt="Email Icon" width="16" height="16" loading="lazy">
                            <a href="mailto:jakirpllc@gmail.com">jakirpllc@gmail.com</a>
                        </li>
                        <li class="flex-row">
                            <img src="/icons//location.svg" alt="Address Icon" width="16" height="16" loading="lazy">
                            <a href="https://maps.app.goo.gl/dt1cGB1TUAbwMP5A7">Saham 319, P.O. Box 464, <br> Sultanate of Oman</a>
                        </li>
                        
                    </ul>
                </section>
            </div>
        </div>

        <p> &copy; 2026 Line International Project L.L.C. All Rights Reserved.</p>
    </div>

    <section class="flex-row legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/cookies">Cookie Policy</a>
        <a href="/sitemap">Sitemap</a>
    </section>
</footer>

<style>
    footer {
        color: var(--white-90);
        background-color: var(--primary-100);
        width: 100%;
        font-size: 0.875rem;
        line-height: 1.5;
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
        position: relative;
        padding-inline: 2rem;
    }

    .wrapper {
        width: 100%;
        max-width: var(--max-width);
        border-inline: var(--border-light);
        padding: 1.5rem 1.5rem 5rem;
        gap: 1rem;
    }

    .wrapper > div {
        justify-content: space-between;
    }

    .logo-social {
        width: 8.15rem;
    }

    p {
        margin-top: 1.5rem;
        text-align: center;
    }

    img {
        display: block;
    }

    .legal {
        padding: 1rem 1.5rem;
        gap: 2rem;
        justify-content: center;
        border-top: var(--border-light);
        width: 100%;
        position: absolute;
        bottom: 0;
    }

    .links-container {
        align-items: flex-start;
        gap: 6rem;
        gap: clamp(1rem, 4.5vw ,6rem);
    }

    .contact img {
        margin-right: 1rem;
        margin-top: 0.2rem;
    }

    li {
        list-style-type: none;
        display: flex;
        flex-flow: row nowrap;
        align-items: flex-start;
        margin-top: 1rem;
    }

    h3 {
        font-family: var(--inter);
        font-weight: 600;
    }

    .logo > h3 {
        margin-top: 0.75rem;
        font-size: 1rem;
    }

    .social-cont {
        margin-top: 3rem;
    }

    .social-cont > h3 {
        margin-bottom: 1rem;
        font-weight: 400;
    }

    .socials {
        gap: 2rem;
    }


    @media all and (max-width: 62rem) {
        .logo > h3 {
            font-size: 1.5rem;
        }

        .wrapper > div:first-child {
            flex-direction: column;
            gap: 2rem;
        }

        .logo-social {
            width: 100%;
        }

        .social-cont > h3 {
            margin: 0;
        }

        .social-cont {
            display: flex;
            gap: 1rem;
            align-items: center;
            margin-top: 0;
        }

        .socials {
            gap: 1rem;
        }

        .socials img {
            width: 1rem;
            height: 1rem;
        }

        li {
            margin-top: 0.5rem;
        }

        .links-container {
            align-items: flex-start;
            gap: 1rem;
            justify-content: space-between;
            width: 100%;
        }
    }

    @media all and (max-width: 51rem) {
        .wrapper {
            padding-top: 2.5rem;
        }

        .links-container {
            flex-direction: column;
            gap: 2.5rem
        }

        li {
            margin-top: 0.25rem;
        }

        p {
            margin-top: 2.5rem;
        }

        .legal {
            font-size: 0.625rem;
        }
    }
</style>