---
import heroBG from '../assets/hero-desktop.jpg';
---


<section class="section-container">
    <section class="wrapper stack">
        <section class="hero-text stacked-item">
            <h1>Ready to build your dream?</h1>
            <p>Line International Project L.L.C. delivers professional project solutions and reliable building materials for residential, commercial, and industrial developments. Our commitment to quality, durability, and customer satisfaction has made us a trusted partner for contractors, developers, and homeowners.</p>
            <a href="#">Start your project</a>
        </section>

        <div class="border-div stacked-item"></div>

        <div class="hero-bg stacked-item stack">
            <!-- <img src={heroBG.src} alt="" class="stacked-item"> -->
            <div class="stacked-item background-overlay"></div>
            <div class="stacked-item background-overlay-2"></div>
        </div>
    </section>

    <section class="partners">
        <h2>Our trusted partners</h2>
        <div class="flex-row brand-carousel">
            <img src="/logos/golden-footprint.webp" alt="" width="150" height="150">
            <img src="/logos/asian-paints.webp" alt="" width="150" height="150">
            <img src="/logos/national-paints.webp" alt="" width="150" height="150">
            <img src="/logos/danube.webp" alt="" width="150" height="150">
            <img src="/logos/sterling-sites.webp" alt="" width="150" height="150">
        </div>
    </section>

</section>

<style>
    .stack {
        display: grid;
    }

    .stacked-item {
        grid-area: 1 / 1;
    }

    .section-container {
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
        padding-inline: 2rem;

    }


    h1 {
        font-size: 6.5rem;
        line-height: 1.15;
        font-weight: 400;
        color: var(--primary-200);
        margin-top: 2rem;
    }

    p {
        font-size: 1.25rem;
        line-height: 1.5;
        margin-top: 2rem;
        text-wrap: pretty;
        color: var(--black-10);
    }


    .wrapper {
        max-width: var(--max-width);
    }

    .hero-text {
        width: 55%;
        padding: 2rem;
        z-index: 2;
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
    }

    .border-div {
        border-inline: var(--border-dark);
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    a {
        display: inline-block;
        background-color: var(--primary-400);
        color: var(--white-95);
        padding: 1rem 2.25rem;
        font-size: 1.5rem;
        border-radius: 0.75rem;
        transform-origin: center;
        width: 16.25rem;
        height: 3.8125rem;
        font-weight: 500;
        text-align: center;
        margin-top: 2rem;
        margin-bottom: 5rem;
    }

    a:hover {
        opacity: 0.9;
        text-decoration: none;
    }

    a:active {
        opacity: 0.75;
        transform: scale(0.95);
    }
    
    .hero-bg {
        z-index: 0;
        width: 100%;
        height: 99vh;
        position: absolute;
        top: 0;
        left: 0;
        overflow: hidden;
        background-image: url("/images/hero-desktop.jpg");
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }

    img {
        height: 150px;
        width: 150px;
    }

    .background-overlay {
        width: 100%;
        height: 100%;
        background-image: linear-gradient(
            90deg,
            hsla(0, 0%, 100%, 0.9) 0%, 
            hsla(0, 0%, 100%, 0.65) 45%, 
            hsla(0, 0%, 100%, 0) 65% 
        )
    }

    .background-overlay-2 {
        width: 100%;
        height: 100%;
        background-image: linear-gradient(
            hsla(0, 99%, 48%, 0) 80%, 
            hsla(0, 0%, 95%, 1) 100% 
        )
    }

    h2 {
        font-family: var(--inter);
        color: var(--primary-200);
        text-align: center;
        font-size: 1.5rem;
    }

    .partners {
        padding: 2rem 2rem 4rem;
        width: 100%;
        max-width: var(--max-width);
        border-inline: var(--border-dark);
        z-index: 1;
    }

    .brand-carousel {
        flex-wrap: wrap;
        justify-content: space-evenly;
        width: 100%;
        margin-top: 2rem;
    }

</style>