---
import heroBG from '../assets/hero-desktop.jpg';
---


<section class="section-container">
    <section class="wrapper stack">
        <section class="hero-text stacked-item">
            <h1>Ready to build your dream?</h1>
            <p>Line International Project L.L.C. delivers professional project solutions and reliable building materials for residential, commercial, and industrial developments. Our commitment to quality, durability, and customer satisfaction has made us a trusted partner for contractors, developers, and homeowners.</p>
            <a href="#contact-form">Start your project</a>
        </section>

        <div class="border-div stacked-item"></div>

        <div class="hero-bg stacked-item stack">
            <div class="stacked-item background-overlay"></div>
            <div class="stacked-item background-overlay-2"></div>
        </div>
    </section>

    <section class="partners">
        <h3>Our trusted partners</h3>
        <div class="flex-row brand-carousel">
            <img src="/logos/golden-footprint.webp" alt="" width="150" height="150" loading="lazy">
            <img src="/logos/asian-paints.webp" alt="" width="150" height="150" loading="lazy">
            <img src="/logos/national-paints.webp" alt="" width="150" height="150" loading="lazy">
            <img src="/logos/danube.webp" alt="" width="150" height="150" loading="lazy">
            <img src="/logos/sterling-sites.webp" alt="" width="150" height="150" loading="lazy">
        </div>
    </section>

</section>

<style>
    .section-container {
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
        padding-inline: 2rem;

    }


    h1 {
        font-size: 6.5rem;
        font-size: var(--font-104);
        line-height: 1.15;
        font-weight: 400;
        color: var(--primary-200);
        margin-top: 2rem;
        margin-top: clamp(1rem, 2.5vh, 2rem);
    }

    p {
        font-size: 1.25rem;
        font-size: var(--font-20);
        line-height: 1.5;
        margin-top: 2rem;
        margin-top: clamp(1rem, max(3vh, 3vw), 2rem);
        text-wrap: pretty;
        color: var(--black-10);
        font-weight: 500;
    }


    .wrapper {
        width: 100%;
        max-width: var(--max-width);
    }

    .hero-text {
        width: 55%;
        width: clamp(16rem, 50vw, 49.5rem);
        padding: 2rem;
        z-index: 2;
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
    }

    .border-div {
        border-inline: var(--border-dark);
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    a {
        display: inline-block;
        background-color: var(--primary-400);
        color: var(--white-95);
        padding: 1rem 2.25rem;
        padding: clamp(0.75rem, 1vw, 1rem) clamp(1.5rem, 2vw, 2.25rem);
        font-size: 1.5rem;
        font-size: var(--font-24);
        border-radius: 0.75rem;
        transform-origin: center;
        font-weight: 500;
        text-align: center;
        margin-top: 2rem;
        margin-bottom: 5rem;
        margin-top: clamp(1rem, max(3vh, 3vw), 2rem);
        margin-bottom: clamp(2rem, max(3vh, 3vw), 5rem);
    }

    a:hover {
        background-color: var(--primary-200);
        text-decoration: none;
        opacity: 1;
    }

    a:active {
        opacity: 0.8;
        transform: scale(0.95);
    }
    
    .hero-bg {
        z-index: 0;
        width: 100%;
        height: 99vh;
        height: clamp(40rem, 65vw, 44rem);
        position: absolute;
        top: 0;
        left: 0;
        overflow: hidden;
        background-image: url("/images/hero-desktop.webp");
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }

    img {
        min-height: 50px;
        height: clamp(50px, min(9.375vw, 16vh), 150px);
        max-height: 150px;

        max-width: 150px;
        width: clamp(50px, min(9.375vw, 16vh), 150px);
        min-width: 50px;
    }

    .background-overlay {
        width: 100%;
        height: 100%;
        background-image: linear-gradient(
            90deg,
            hsla(0, 0%, 100%, 0.9) 0%, 
            hsla(0, 0%, 100%, 0.65) 45%, 
            hsla(0, 0%, 100%, 0) 65% 
        )
    }

    .background-overlay-2 {
        width: 100%;
        height: 100%;
        background-image: linear-gradient(
            hsla(0, 99%, 48%, 0) 80%, 
            hsla(0, 0%, 95%, 1) 100% 
        )
    }

    h3 {
        font-family: var(--inter);
        color: var(--primary-200);
        text-align: center;
        font-size: 1.5rem;
        font-size: var(--font-24);
        font-weight: 600;
    }

    .partners {
        padding: 2rem 2rem 4rem;
        width: 100%;
        max-width: var(--max-width);
        border-inline: var(--border-dark);
        z-index: 1;
    }

    .brand-carousel {
        flex-wrap: wrap;
        justify-content: space-evenly;
        width: 100%;
        gap: 2rem;
        margin-top: 2rem;
    }

    @media all and (max-width: 36rem) {
        .hero-text {
            width: 100%;
        }

        .background-overlay {
        width: 100%;
        height: 100%;
        background: hsla(0, 0%, 100%, 0.75);
    }
    }

</style>