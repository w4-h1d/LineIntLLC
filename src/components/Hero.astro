---
import heroDesktop from '../assets/images/hero-desktop.webp';

import PlayIcon from '../assets/icons/play-media-icon.svg';
import PauseIcon from '../assets/icons/pause-media-icon.svg';

import GoldenLogo from '../assets/logos/golden-footprint.webp';
import AsianLogo from '../assets/logos/asian-paints.webp';
import NationalLogo from '../assets/logos/national-paints.webp';
import DanubeLogo from '../assets/logos/danube.webp';
import SterlingLogo from '../assets/logos/sterling-sites.webp';

import { Image } from 'astro:assets';
---


<section class="hero section-container">
    <section class="wrapper ">
        <div class="hero-text-cont">
            <section class="hero-text">
                <h1>Ready to build your dream?</h1>
                <p>Line International Project L.L.C. delivers professional project solutions and reliable building materials for residential, commercial, and industrial developments. Our commitment to quality, durability, and customer satisfaction has made us a trusted partner for contractors, developers, and homeowners.</p>
                <a href="#contact-form">Start your project</a>
            </section>

            <button data-video-play="true" class="stack" aria-label="Video Play/Pause Button">
                <PlayIcon width={48} height={48} fill="currentColor" class="media-icon play-icon stacked-item" />
                <PauseIcon width={48} height={48} fill="currentColor" class="media-icon pause-icon stacked-item" />
                <span class="button-bg"></span>
            </button>
        </div>
    </section>

    <div>
        <section class="partners">
            <h2>Our trusted partners</h2>
            <div class="flex-row brand-carousel">
                <Image 
                    src={ GoldenLogo } 
                    alt="The Golden Footprint Logo" 
                    width={ GoldenLogo.width } 
                    height={ GoldenLogo.height }
                />
                <Image 
                    src={ AsianLogo } 
                    alt="Asian Paints Logo" 
                    width={ AsianLogo.width } 
                    height={ AsianLogo.height }
                />
                <Image 
                    src={ NationalLogo } 
                    alt="National Paints Logo" 
                    width={ NationalLogo.width } 
                    height={ NationalLogo.height }
                />
                <Image 
                    src={ DanubeLogo } 
                    alt="The Golden Footprint Logo" 
                    width={ DanubeLogo.width } 
                    height={ DanubeLogo.height }
                />
                <Image 
                    src={ SterlingLogo } 
                    alt="The Golden Footprint Logo" 
                    width={ SterlingLogo.width } 
                    height={ SterlingLogo.height }
                />
            </div>
        </section>
    </div>


    <div class="hero-bg stacked-item stack">
        <video autoplay loop muted class="stacked-item" data-bg-video>
            <source src="promo.mp4" type="video/mp4" >
        </video>

        <picture class="stacked-item">
            <source srcset="/images/hero-square-2.webp" media="(max-width: 576px)">
            <Image 
                src={ heroDesktop } 
                alt="Modern Duplex House with Car Parking" 
                width={ heroDesktop.width } 
                height={ heroDesktop.height }
                loading="eager"
                fetchpriority="high" 
            />
        </picture>

        <div class="stacked-item background-overlay"></div>
    </div>
</section>

<script>
    const videoPlayBtn = document.querySelector("[data-video-play]") as HTMLButtonElement | null;
    const video = document.querySelector("[data-bg-video]") as HTMLVideoElement | null;

    videoPlayBtn?.addEventListener("click", () => {
        if (video?.paused) {
            video.play();
            video.classList.remove("hide");
            videoPlayBtn.dataset.videoPlay = "true";
        } else {
            video?.pause();
            video?.classList.add("hide");
            videoPlayBtn.dataset.videoPlay = "false";
        }
    });
</script>

<style>
    .hide {
        opacity: 0;
    }

    .wrapper {
        width: 100%;
        position: relative;
        z-index: 2;
        padding-inline: var(--outer-padding-inline);
    }


    h1 {
        font-size: 6.5rem;
        font-size: var(--font-104);
        line-height: 1.15;
        font-weight: 400;
        color: var(--primary-200);
        color: var(--primary-900);
        margin-top: 2rem;
        margin-top: clamp(1rem, 2.5vh, 2rem);
    }

    p {
        font-size: 1.25rem;
        font-size: var(--font-20);
        line-height: 1.5;
        margin-top: 2rem;
        margin-top: clamp(1rem, max(3vh, 3vw), 2rem);
        text-wrap: pretty;
        color: var(--primary-900);
        opacity: 0.85;
        font-weight: 500;
    }


    .hero-text-cont {
        border-inline: var(--border-light);
        border-color: var(--primary-900);
        margin: 0 auto;
        width: 100%;
        max-width: var(--max-width);
        min-height: calc(min(100vh, 67.5rem) - 7.25rem - 2px);

        position: relative;
    }

    .hero-text {
        width: 55%;
        width: clamp(16rem, 55vw, 49.5rem);
        padding: 2rem 4rem;
        z-index: 2;
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
    }


    button {
        position: absolute;
        bottom: var(--inner-padding-inline);
        right: var(--inner-padding-inline);
        width: 3rem;
        height: 3rem;
        padding: 0.5rem;
        border-radius: 0.75rem;
        background-color: transparent;
        border: 1px solid var(--white-95);
        cursor: pointer;
        overflow: hidden;
        transition: all ease-in-out 0.25s;
    }

    button svg {
        width: 100%;
        height: 100%;
        color: var(--white-95);
    }

    .button-bg {
        display: block;
        position: absolute;
        bottom: 0;
        left: 50%;
        background-color: var(--primary-400);
        width: 10%;
        height: 100%;
        border-radius: 2rem;
        z-index: -1;
        transform: translateX(-50%) translateY(100%);
        transition: all 0.35s;
    }

    button:hover > .button-bg {
        left: 0;
        transform: translateX(0) translateY(0);
        border-radius: 0.425rem;
        width: 100%;
    }

    button:active {
        transform: scale(0.95);
        opacity: 0.8;
    }

    button[data-video-play="true"] .pause-icon {
        opacity: 1;
    }

    button[data-video-play="false"] .pause-icon {
        opacity: 0;
    }

    button[data-video-play="true"] .play-icon {
        opacity: 0;
    }

    button[data-video-play="false"] .play-icon {
        opacity: 1;
    }

    a {
        display: inline-block;
        background-color: var(--primary-900);
        color: var(--primary-200);
        padding: clamp(0.75rem, 1vw, 1rem) clamp(1.5rem, 2vw, 2.25rem);
        font-size: var(--font-24);
        border-radius: 0.75rem;
        transform-origin: center;
        font-weight: 500;
        text-align: center;
        margin-top: clamp(1rem, max(3vh, 3vw), 2rem);
        margin-bottom: clamp(2rem, max(3vh, 3vw), 5rem);
    }

    a:hover {
        background-color: var(--primary-400);
        color: var(--primary-900);
        text-decoration: none;
        opacity: 1;
    }

    a:active {
        opacity: 0.8;
        transform: scale(0.95);
    }
    
    .hero-bg {
        z-index: 0;
        width: 100%;
        height: clamp(50rem, 100vh, 67.5rem);
        position: absolute;
        top: 0;
        left: 0;
        overflow: hidden;
    }

    video {
        width: 100%;
        height: inherit;
        object-fit: cover;
        object-position: center;
        z-index: 2;
        display: block;
        transition: opacity ease-in-out 0.25s;
    }

    picture {
        height: inherit;
    }

    picture img {
        display: block;
        z-index: 0;
        width: 100%;
        height: inherit;
        object-fit: cover;
    }


    .background-overlay {
        width: 100%;
        height: inherit;
        background-color: hsla(0, 0%, 0%, 0.6);
        z-index: 10;
    }

    h2 {
        font-family: var(--inter);
        color: var(--primary-200);
        text-align: center;
        font-size: 1.5rem;
        font-size: var(--font-24);
        font-weight: 600;
    }

    div:has(.partners) {
        position: relative;
        z-index: 2;
        background-color: var(--white-95);
        width: 100%;
        padding-inline: var(--outer-padding-inline);
    }

    .partners {
        padding: 2rem var(--inner-padding-inline) 4rem;
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        border-inline: var(--border-dark);

    }


    .brand-carousel {
        flex-wrap: wrap;
        justify-content: space-evenly;
        width: 100%;
        gap: 2rem;
        margin-top: 2rem;
        padding-inline: 2rem;
    }

    .brand-carousel > img {
        min-height: 50px;
        height: clamp(50px, min(9.375vw, 16vh), 150px);
        max-height: 150px;

        max-width: 150px;
        width: clamp(50px, min(9.375vw, 16vh), 150px);
        min-width: 50px;
    }


    @media all and (max-width: 36rem) {
        .hero-text-cont {
            min-height: 0;
        }

        .hero-text {
            width: 100%;
            padding-inline: var(--inner-padding-inline);
        }

        .hero-bg {
            height: max(100svh, clamp(47rem, 65.5vw, 56rem));
        }

        p {
            font-weight: 400;
        }
    }

    @media all and (max-width: 26rem) {
        button {
            width: 2rem;
            height: 2rem;
            padding: 0.5rem;
        }
    }

</style>