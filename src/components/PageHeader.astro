---
import logo from "../assets/Line-Logo.png";
---


<header>
    <div class="flexRow">
        <section class="flexRow">
            <a href="/"><img src={logo.src} alt="Logo of Line International Project LLC" width="72px" height="72px"></a>
            <h2>Line International Project L.L.C.</h2>
        </section>

        <nav>
            <ul class="flexRow">
                <li><a href="#portfolio">Portfolio</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="/about">About Us</a></li>
                <li><a href="/locations">Locations</a></li>
            </ul>
        </nav>
    </div>
</header>


<style>
    :root {
        --primary-color: #143642;
    }

    header {
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
        border-bottom: 2px solid var(--primary-color);
        padding-inline: 2rem;
    }

    div {
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        width: 100%;
        max-width: 1440px;
        border-inline: 2px solid var(--primary-color);
    }

    section {
        gap: 1rem;
    }

    ul {
        gap: 1rem;
    }

    li > a {

        padding: 0.5rem
    }

    li {
        list-style-type: none;
    }


</style>