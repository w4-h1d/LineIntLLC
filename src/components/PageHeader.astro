---


---


<header>
    <div class="flex-row">
        <section class="flex-row">
            <a href="/"><img src="/icons/line-logo.svg" alt="Logo of Line International Project LLC" width="72" height="72" loading="eager"></a>
            <h2>Line&nbsp;International Project&nbsp;L.L.C.</h2>
        </section>

        <nav id="navigation">
            <ul class="flex-row">
                { Astro.props.page !== "home" && <li><a href="/">Home</a></li>}
                <li><a href="/#portfolio">Portfolio</a></li>
                <li><a href="/#services">Services</a></li>
                { Astro.props.page !== "about" && <li><a href="/about">About&nbsp;Us</a></li>}
                { Astro.props.page !== "locations" && <li><a href="/locations">Locations</a></li> }
            </ul>
        </nav>

        <button aria-label="Menu Button" id="menuButton">
            <span></span>
        </button>

        <script>
            const menuButton = document.getElementById("menuButton");
            const navigation = document.getElementById("navigation");
            

            menuButton?.addEventListener("click", () => {
                if (navigation !== null ) {
                    navigation.classList.toggle("open");
                    menuButton.toggleAttribute("opened");
                }
            });
        </script>
    </div>
</header>


<style>
    header {
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
        border-bottom: var(--border-dark);
        padding-inline: 2rem;
        color: var(--primary-200);
        position: relative;
        z-index: 10;
    }

    h2 {
        font-family: var(--inter);
        font-weight: 500;
        font-optical-sizing: auto;
        font-size: 1.75rem;
    }

    img {
        margin-top: 0.5rem;
    }

    div {
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        width: 100%;
        max-width: var(--max-width);
        border-inline: var(--border-dark);
    }

    section {
        gap: 1rem;
    }

    ul {
        gap: 2rem;
    }

    li > a {
        font-size: 1.25rem;
        padding: 0.5rem
    }

    li {
        list-style-type: none;
    }

    button {
        display: none;
        width: 2.5rem;
        height: 2.5rem;
        min-width: 2rem;
        min-height: 2rem;
        border: 1px solid var(--primary-200);
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all ease-in-out 0.25s;
        transform-origin: center;
        background-color: transparent;
    }

    button:hover {
        background-color: var(--primary-200);
    }

    button:active {
        transform: scale(0.95);
        opacity: 0.8;
    }



    @media all and (max-width: 70rem) {
        h2 {
            font-size: 1.5rem;
        }

        li > a {
            font-size: 1rem;
        }

        img {
            width: 3rem;
            height: 3rem;
        }

        ul {
            gap: 1.5rem;
            
        }
    }

    @media all and (max-width: 62rem) {

        header {
            transition: background-color 0.5s;
        }

        header:has(button[opened]), div:has(button[opened]) {
            background-color: var(--white-95);
        }

        nav {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding-inline: 2rem;
            transform: translateY(-18rem);
            border-bottom: var(--border-dark);
            transition: all ease-in-out 0.5s;
            z-index: -1;
            background-color: var(--white-95) ;
        }

        ul {
            flex-flow: column nowrap;
            border-inline: var(--border-dark);
            gap: 0;
        }

        li {
            width: 100%;
        }

        li > a {
            display: block;
            border-top: var(--border-dark);
            width: 100%;
            padding: 1rem
        }

        li > a:hover {
            background-color: var(--primary-200);
            color: var(--white-95);
            opacity: 1;
            text-decoration: none;
            padding-left: 2rem;
        }

        h2 {
            font-size: 1.25rem;
        }

        button {
            display: block;
            flex-flow: column nowrap;
            justify-content: center;
            padding: 0.75rem;
            align-items: center;
        }

        .open {
            transform: translateY(5.5rem);
        }

        span, span::after, span::before {
            display: block;
            height: 2px;
            background-color: var(--primary-200);
            border-radius: 1rem;
            transition: all ease-in-out 0.5s;
        }

        span::before, span::after {
            content: "";
        }

        span::before {
            transform: translateY(-0.3755rem);
        }

        span::after {
            transform: translateY(0.25rem);
        }

        button:hover span, button:hover span::after, button:hover span::before {
            background-color: var(--white-90);
        }

        button[opened] span::after {
            transform:  translateY(-0.125rem);
        }

        button[opened] span {
            transform: rotate(135deg);
        }

        button[opened] span::before {
            transform: translateY(0) rotate(90deg);
        }
    }

    @media all and (max-width: 26rem) {
        h2 {
            font-size: 1rem;
        }

        button {
            width: 2rem;
            height: 2rem;
            padding: 0.5rem;
        }
        section {
            gap: 0.5rem;
        }
    }


</style>