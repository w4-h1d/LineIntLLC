---
import Slide from '../components/Slide.astro';
import 'swiper/css';
import 'swiper/css/pagination';

import PreviousIcon from '../assets/icons/previous-media-icon.svg';
import NextIcon from '../assets/icons/next-media-icon.svg';
import PlayIcon from '../assets/icons/play-media-icon.svg';
import PauseIcon from '../assets/icons/pause-media-icon.svg';

import Project1 from '../assets/images/project-1.png';
import Project2 from '../assets/images/project-2.png';
import Project3 from '../assets/images/project-3.png';
---

<section id="portfolio">
    <div class="wrapper">
        <h2>Our Project Portfolio</h2>

        <div class="swiper">
            <div class="swiper-wrapper">
                <Slide 
                    client="Ahmed Ali Mohammed Al Farsi" 
                    location="Mejaz Al Sugra, Saham" 
                    start="01/07/2024" 
                    end="01/05/2025" 
                    img={ Project1 } 
                    project="Project 1"
                />
                <Slide 
                    client="Aisha Ibrahim Hasan Al Mamari" 
                    location="Liwa Al Jadidah P.A." 
                    start="01/07/2025" 
                    end="30/06/2026" 
                    img={ Project2 } 
                    project="Project 2"
                />
                <Slide 
                    client="Meher Khamis Taeeb Chenen Al Kahali" 
                    location="Um Al-Jareef, Saham" 
                    start="01/12/2025" 
                    end="30/11/2026" 
                    img={ Project3 } 
                    project="Project 3"
                />
            </div>
            <div>
                <div class="progress-bar"><div class="progress" id="progress"></div></div>
            </div>

            <div class="swiper-pagination flex-row"></div>


            <div class="button-container">
                <button class="swiper-button-prev">
                    <PreviousIcon width={48} height={48} fill="currentColor" class="media-icon" />
                </button>
                <button id="pauseBtn" data-slider-autoplay="true" class="stack">
                    <PlayIcon width={48} height={48} fill="currentColor" class="media-icon play-icon stacked-item"  />
                    <PauseIcon width={48} height={48} fill="currentColor" class="media-icon pause-icon stacked-item"  />
                </button>
                <button class="swiper-button-next">
                    <NextIcon width={48} height={48} fill="currentColor" class="media-icon"  />
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Script for the Portfolio Carousel -->
<script>
    const restartAnimations = ($el:any) => {
        $el.getAnimations().forEach((anim:any) => {
            anim.cancel();
            anim.play();
        });
    };

    const progress = document.getElementById("progress") as HTMLElement | null;

    const autoplayBtn = document.getElementById("pauseBtn") as HTMLButtonElement | null;

    import Swiper from 'swiper';
    import { Navigation, Pagination, Autoplay, Parallax, Keyboard, EffectCoverflow} from 'swiper/modules';
    const swiper = new Swiper('.swiper', {
        modules: [Navigation, Pagination, Autoplay, Parallax, Keyboard, EffectCoverflow],

        a11y: {
            prevSlideMessage: 'Previous slide',
            nextSlideMessage: 'Next slide',
        },

        autoplay: {
            delay: 10000,
            disableOnInteraction: false,
        },

        direction: 'horizontal',

        effect: 'coverflow',

        coverflowEffect: {
            rotate: 60,
        },

        loop: true,

        pagination: {
            el: '.swiper-pagination',
            clickable: true,
        },

        navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
            addIcons: false,
        },

        parallax: true,

        keyboard: true,

        watchSlidesProgress: true,

        on: {
            slideChangeTransitionEnd: () => {
            
                if (document.getElementById("pauseBtn")?.dataset.sliderAutoplay === "true") {
                    restartAnimations(progress);
                }
            }
        }
    });

    autoplayBtn?.addEventListener("click", () => {
        if (autoplayBtn.dataset.sliderAutoplay === "true") {
            swiper.autoplay.stop();
            autoplayBtn.dataset.sliderAutoplay = "false";

            progress?.getAnimations().forEach(anim => {
                anim.pause();
            });
        } else if (autoplayBtn.dataset.sliderAutoplay === "false") {
            swiper.autoplay.start();
            autoplayBtn.dataset.sliderAutoplay = "true";

            restartAnimations(progress);
            progress?.getAnimations().forEach(anim => {
                anim.play();
            })
        }
    });
</script>

<style>
    section {
        border-top: var(--border-dark);
        padding-inline: 2rem;
        scroll-margin-top: -3rem;
    }

    .wrapper {
        max-width: var(--max-width);
        border-inline: var(--border-dark);
        margin: 0 auto;
        padding: 4rem 2rem 6rem;
    }

    h2 {
        text-align: center;
        color: var(--primary-200);
        margin-bottom: 2rem;
    }

    .swiper-wrapper {
        width: 100%;
        width: clamp(400px, 100%, 1200px);
        height: clamp(16.25rem, 75vh, 60rem);
        container: carousel / size;
        margin: 0;
    }

    .button-container {
        position: absolute;
        right: clamp(1rem, 2vw, 2rem);
        bottom: clamp(1.5rem, 2.5vw, 2.5rem);
        z-index: 10;
    }

    button {
        display: inline-grid;
        color: var(--white-95);
        background-color: var(--primary-400);
        border: 1px solid var(--gray);
        padding: 0.75rem;
        width: clamp(2.5rem, 3vw, 3rem);
        height: clamp(2.5rem, 3vw, 3rem);

        transition: all ease-in-out 0.25s;
        transition-delay: 0.1s;

        cursor: pointer;
    }

    button:hover {
        background-color: var(--primary-200);
        transition-delay: 0s;
    }

    button:active {
        opacity: 0.8;
        transform: scale(0.95);
    }

    .media-icon {
        width: 100%;
        height: 100%;
    }

    button[data-slider-autoplay="true"] > .play-icon {
        opacity: 0;
    }
    button[data-slider-autoplay="false"] > .play-icon {
        opacity: 1;
    }

    button[data-slider-autoplay="true"] > .pause-icon {
        opacity: 1;
    }
    button[data-slider-autoplay="false"] > .pause-icon {
        opacity: 0;
    }

    .swiper-button-prev {
        border-top-left-radius: var(--border-radius);
        border-bottom-left-radius: var(--border-radius);
        transform: translateX(1px);
    }

    .swiper-button-next {
        border-top-right-radius: var(--border-radius);
        border-bottom-right-radius: var(--border-radius);
        transform: translateX(-1px);
    }

    .swiper-pagination {
        --swiper-pagination-bottom: clamp(1.5rem, 2.5vw, 2.5rem);
        --swiper-pagination-color: var(--primary-400);
        --swiper-pagination-bullet-inactive-color: var(--gray);
        --swiper-pagination-bullet-inactive-opacity: 1;
        background-color: rgba(from var(--white-95) r g b / 0.8);
        width: fit-content;
        left: 50%;
        transform: translateX(-50%);
        padding: 0.25rem;
        border-radius: 1rem;
    }

        div:has(> .progress-bar) {
        background-color: var(--white-95);
        width: 100%;
        height: 1rem;
        position: absolute;
        bottom: 0;
        z-index: 10;
    }

    .progress-bar {
        background-color: var(--white-85);
        width: 100%;
        height: 100%;
        border-bottom-left-radius: var(--border-radius);
        border-bottom-right-radius: var(--border-radius);
        overflow: hidden;
    }

    .progress {
        --autoplay-delay: 10s;

        background-color: var(--primary-400);
        height: 100%;
        transform-origin: left;
        animation-name: progressBarAnimation;
        animation-duration: var(--autoplay-delay);
        animation-timing-function: linear;
        animation-fill-mode: forwards;
    }

    section:has(#pauseBtn[data-slider-autoplay="false"]) .progress {
        opacity: 0.75;
        animation-play-state: paused !important; 
    }

    @keyframes progressBarAnimation {
        from {
            transform: scaleX(0%);
        }
        to {
            transform: scaleX(100%);
        }
    }

    @media all and (max-width: 36rem)  {
        .swiper-wrapper {
            width: 100%;
            container-type: inline-size;
            height: auto;
        }

        .swiper-pagination {
            position: static;
            transform: translateX(0);
            margin: 0.5rem auto;
        }

        button {
            padding: 0.5rem;
        }

        div:has(> .progress-bar) {
            bottom: calc(4.5rem - 1px);
        }

        .progress-bar {
            border: 1px solid var(--gray);
        }

        .button-container {
            position: static;
            margin-inline: auto;
            width: fit-content;
        }
    }
</style>